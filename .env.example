# Copy to .env.local for local dev, and add the same keys in Vercel → Settings → Environment Variables.
# NEXT_PUBLIC_* values are baked in at BUILD time — after adding/changing one on Vercel, redeploy.

NEXT_PUBLIC_SITE_URL=https://acegraphiix.com

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Used by the daily Drive sync (no user signed in). Never expose.
SUPABASE_SERVICE_ROLE_KEY=

# Google Cloud → APIs & Services → Credentials → API key, with the Drive API enabled.
# Restrict it to "Google Drive API" only.
GOOGLE_API_KEY=

# Any long random string. Vercel's cron sends it; the sync route checks it.
CRON_SECRET=

# Optional: email Jeremiah whenever the contact form is used (https://resend.com)
RESEND_API_KEY=
NOTIFY_EMAIL=acegraphiix@gmail.com
# NOTIFY_FROM="Acegraphiix Website <hello@yourdomain.com>"   # after verifying a domain in Resend
